    {
      "name": "02 — NONE → COMPLETED",
      "item": [
        {
          "name": "Crear — NONE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{orderUrl}}/api/v1/orders",
            "description": "Crea una nueva orden en cada ejecución. Comprueba el resultado de la Saga; no demuestra por sí sola los efectos en las bases de datos participantes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUS-001\",\n  \"productId\": \"PROD-001\",\n  \"quantity\": 2,\n  \"amount\": 150.0,\n  \"scenario\": \"NONE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"orderId_NONE\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "let data;",
                  "try { data = pm.response.json(); } catch (e) { pm.test(\"Respuesta JSON\", () => { throw e; }); }",
                  "if (data) {",
                  " pm.test(\"Estado terminal esperado\", () => pm.expect(data.status).to.eql(\"COMPLETED\"));",
                  " pm.test(\"orderId UUID\", () => pm.expect(data.orderId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  " pm.test(\"sagaId UUID\", () => pm.expect(data.sagaId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  " if (pm.response.code === 201 && data.orderId) { pm.collectionVariables.set(\"orderId_NONE\", data.orderId); pm.collectionVariables.set(\"orderId\", data.orderId); pm.collectionVariables.set(\"sagaId\", data.sagaId); }",
                  " pm.test(\"Sin fallo\", () => pm.expect(data.failureReason).to.eql(null));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar orden persistida",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{orderUrl}}/api/v1/orders/{{orderId_NONE}}",
            "description": "Ejecutar después de Crear en esta carpeta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Misma orden\", () => pm.expect(data.orderId).to.eql(pm.collectionVariables.get(\"orderId_NONE\")));",
                  "pm.test(\"Estado persistido\", () => pm.expect(data.status).to.eql(\"COMPLETED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
