              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"orderId_RELEASE_FAILED\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "let data;",
                  "try { data = pm.response.json(); } catch (e) { pm.test(\"Respuesta JSON\", () => { throw e; }); }",
                  "if (data) {",
                  " pm.test(\"Estado terminal esperado\", () => pm.expect(data.status).to.eql(\"COMPENSATION_FAILED\"));",
                  " pm.test(\"orderId UUID\", () => pm.expect(data.orderId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  " pm.test(\"sagaId UUID\", () => pm.expect(data.sagaId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  " if (pm.response.code === 201 && data.orderId) { pm.collectionVariables.set(\"orderId_RELEASE_FAILED\", data.orderId); pm.collectionVariables.set(\"orderId\", data.orderId); pm.collectionVariables.set(\"sagaId\", data.sagaId); }",
                  " pm.test(\"Motivo de fallo conservado\", () => pm.expect(data.failureReason).to.be.a(\"string\").and.not.empty);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar orden persistida",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{orderUrl}}/api/v1/orders/{{orderId_RELEASE_FAILED}}",
            "description": "Ejecutar después de Crear en esta carpeta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Misma orden\", () => pm.expect(data.orderId).to.eql(pm.collectionVariables.get(\"orderId_RELEASE_FAILED\")));",
                  "pm.test(\"Estado persistido\", () => pm.expect(data.status).to.eql(\"COMPENSATION_FAILED\"));"
                ]
              }
            }
          ]
        }
      ]
